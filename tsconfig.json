{
  // O Expo reescreve este arquivo ao iniciar se o `extends` não estiver aqui —
  // e o arquivo modificado trava o próximo `git pull`. Melhor já vir assim.
  // As opções abaixo sobrescrevem a base: o rigor do projeto é mantido.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Intl"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "app", "tests", "*.config.ts", "eslint.config.mjs"]
}
