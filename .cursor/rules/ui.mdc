// CalcularETA calcula o tempo estimado de chegada baseado em distância,
// velocidade média e tempos de parada.
func CalcularETA(
    ctx context.Context,
    distancia float64,
    velocidadeMedia float64,
    tempoCarregamento time.Duration,
    tempoDescarga time.Duration,
) (time.Time, error)### Geofence Validation:
